{
  "manifest_version": 3,
  "name": "Gut Test Extension",
  "version": "4.0.0",
  "description": "Draai gut tests met klanten: intro-slide, alle websites eerst bekijken, daarna beoordelen op één pagina. Met notities via de telefoon (QR) en achtergrondmuziek.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "commands",
    "unlimitedStorage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/qrcode.js",
        "gte_data.js",
        "content.js",
        "tab_number_overlay.js"
      ],
      "css": [
        "tab_number_overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-cycling": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Open de intro van de actieve gut test, of stop de lopende test"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
